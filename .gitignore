# PDFs are never committed; data/verified_rhp_manifest.csv records URL + SHA-256 so any
# document can be re-fetched from SEBI / BSE SME and verified.
*.pdf

# Everything bulky and local-only lives under _local/, so the root stays readable:
#   _local/rhp_manual    the 28 hand-supplied prospectuses (279 MB)
#   _local/rhp_fetched   PDFs fetched by fetch_rhp.py
#   _local/backup_*      pre-git-history snapshots from 28 September
# None of it is committed. Every PDF is re-fetchable from SEBI / BSE SME via
# data/verified_rhp_manifest.csv, which records each URL and its SHA-256. The one file
# in there that WAS tracked - manual_rhp/SOURCES.csv - is now data/rhp_sources.csv.
_local/
__pycache__/
*.pyc
.venv/
.env
reports/~$*.xlsx
data/bhavcopy_cache/
# The RAW bhavcopies model_h_turnover.py re-fetches, kept for the same reason: bulky,
# local, and re-fetchable from the exchange. Every row it produces records its source URL
# and the column the value came from, so nothing in the output depends on keeping these.
data/bhavcopy_raw_cache/

# watch_progress.py keeps its last reading here so a second run can compute a rate.
# Per-machine scratch, not data.
data/.watch_state.json
data/rhp_text_cache/
_local/check_set_dump/

# macOS Finder metadata. The project moved to a Mac on 2026-11-02 (the Windows laptop's
# disk died); Finder writes one of these into any directory it has opened.
.DS_Store
